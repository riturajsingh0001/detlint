{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "detlint",
          "version": "test",
          "informationUri": "https://github.com/riturajsingh0001/detlint",
          "rules": [
            {
              "id": "metadata",
              "name": "metadata",
              "shortDescription": {
                "text": "rule metadata hygiene"
              }
            },
            {
              "id": "typos",
              "name": "typos",
              "shortDescription": {
                "text": "unknown fields and case mistakes"
              }
            },
            {
              "id": "wildcard",
              "name": "wildcard",
              "shortDescription": {
                "text": "overly broad matches"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "metadata",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "rule has no level\nSet level."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "rules/one.yml"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1,
                  "endLine": 1,
                  "endColumn": 6
                }
              }
            }
          ],
          "partialFingerprints": {
            "detlint/v1": "1b009cfaf8edbabddfcbfed5fa32d8e6f59ae042"
          }
        },
        {
          "ruleId": "typos",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "unknown field \"ComandLine\" in selection \"selection\" (schema \"windows_security\"); did you mean \"CommandLine\"?\nDid you mean \"CommandLine\"?"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "rules/two.yml"
                },
                "region": {
                  "startLine": 5,
                  "startColumn": 5,
                  "endLine": 5,
                  "endColumn": 14
                }
              }
            }
          ],
          "partialFingerprints": {
            "detlint/v1": "405f64f03163cb69d0bcbd7dd0155951f9481fbc"
          }
        },
        {
          "ruleId": "wildcard",
          "ruleIndex": 2,
          "level": "note",
          "message": {
            "text": "info only"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "rules/two.yml"
                },
                "region": {
                  "startLine": 14,
                  "startColumn": 3,
                  "endLine": 14,
                  "endColumn": 4
                }
              }
            }
          ],
          "partialFingerprints": {
            "detlint/v1": "75e3e16161384b7a80191d1e563c11c9d02f19e9"
          }
        }
      ]
    }
  ]
}
